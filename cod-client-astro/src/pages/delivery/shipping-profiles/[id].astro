---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import ShippingProfileDetailPageApp from "@/features/delivery/components/ShippingProfileDetailPageApp";
const { id } = Astro.params;
---

<BaseLayout title="CodFlow">
  <main class="min-h-screen">
    <div data-gate-spinner="required" class="flex min-h-screen items-center justify-center" aria-busy="true">
      <GateSpinner branded />
    </div>
    <div data-auth-gate="required" hidden>
      <ShippingProfileDetailPageApp client:only="react" profileId={id!} />
    </div>
  </main>
</BaseLayout>
