---
export const prerender = false;
import BaseLayout from "@/layouts/BaseLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import LandingPageStudioApp from "@/features/landing-pages/components/LandingPageStudioApp";
const { id } = Astro.params;
---

<BaseLayout title="CodFlow">
  <main class="min-h-screen">
    <div data-gate-spinner="required" class="flex min-h-screen items-center justify-center" aria-busy="true">
      <GateSpinner branded />
    </div>
    <div data-auth-gate="required" hidden>
      <LandingPageStudioApp client:only="react" landingPageId={id!} />
    </div>
  </main>
</BaseLayout>
