---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GateSpinner from "@/features/auth/components/GateSpinner";
import TrackingPageApp from "@/features/tracking/components/TrackingPageApp";

// Static shell ships NOTHING of the gated UI: a silent spinner plus a
// [hidden] region that RequireAuth reveals after the session verdict.
---

<BaseLayout title="تتبع الطلبات — CodFlow">
  <main class="min-h-screen">
    <div
      data-gate-spinner="required"
      class="flex min-h-screen items-center justify-center"
      aria-busy="true"
    >
      <GateSpinner branded />
    </div>

    <div data-auth-gate="required" hidden>
      <TrackingPageApp client:only="react" />
    </div>
  </main>
</BaseLayout>
