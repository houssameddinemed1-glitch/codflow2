---
import type { Product } from "@/core/api/types";
import { Icon } from "astro-icon/components";

interface Props {
  product: Product;
  basePrice: number;
  comparePrice: number | null;
  cur: string;
  isLowStock: boolean;
  lowStockText: string;
  isDesktop?: boolean;
}

const { product, basePrice, comparePrice, cur, isLowStock, lowStockText, isDesktop = false } = Astro.props;
const hasDiscount = comparePrice != null && comparePrice > basePrice;

function fmt(n: number) {
  return n.toLocaleString("ar-DZ");
}
---

<div class:list={[isDesktop ? "hidden lg:block" : "lg:hidden", "mb-8"]}>
  <h1 class:list={[isDesktop ? "text-3xl" : "text-2xl", "font-black leading-tight mb-3 tracking-tight"]} style="color: var(--clr-text)">
    {product.name}
  </h1>
  
  {product.description && (
    <div class:list={[isDesktop ? "text-[1.0625rem] mb-6" : "text-[0.9375rem] mb-4", "product-rich font-medium leading-relaxed"]} style="color: var(--clr-text-2)" set:html={product.description} />
  )}

  <div class="flex items-baseline gap-4">
    <span class:list={[isDesktop ? "text-4xl" : "text-3xl", "font-black"]} style="color: var(--clr-primary)" id={isDesktop ? "price-display-desktop" : "price-display-mobile"}>
      {fmt(basePrice)} <span class:list={[isDesktop ? "text-2xl" : "text-lg", "font-bold"]}>{cur}</span>
    </span>
    {hasDiscount && (
      <span class:list={[isDesktop ? "text-xl" : "text-base", "line-through font-semibold"]} style="color: var(--clr-text-2)">
        {fmt(comparePrice!)} {cur}
      </span>
    )}
  </div>

  {!isDesktop && isLowStock && (
    <div class="mt-4 inline-flex items-center gap-2 bg-orange-50 text-orange-600 px-3 py-1.5 rounded-xl text-[0.8125rem] font-bold border border-orange-100">
      <Icon name="heroicons:exclamation-triangle" class="w-4 h-4 shrink-0" />
      {lowStockText}
    </div>
  )}
</div>

<style>
  /* Merchant-authored rich description (server-sanitized allowlist). */
  .product-rich h1 { font-size: 1.375em; font-weight: 900; margin: 0.75em 0 0.5em; color: var(--clr-text); }
  .product-rich h2 { font-size: 1.2em; font-weight: 900; margin: 0.75em 0 0.5em; color: var(--clr-text); }
  .product-rich h3 { font-size: 1.05em; font-weight: 800; margin: 0.75em 0 0.5em; color: var(--clr-text); }
  .product-rich p { margin: 0.5em 0; }
  .product-rich p:first-child { margin-top: 0; }
  .product-rich p:last-child { margin-bottom: 0; }
  .product-rich ul { list-style: disc; padding-inline-start: 1.5em; margin: 0.5em 0; }
  .product-rich ol { list-style: decimal; padding-inline-start: 1.5em; margin: 0.5em 0; }
  .product-rich li { margin: 0.25em 0; }
  .product-rich a { color: var(--clr-primary); text-decoration: underline; text-underline-offset: 2px; }
  .product-rich img { max-width: 100%; height: auto; border-radius: var(--radius-card); margin: 0.75em 0; }
  .product-rich u { text-decoration: underline; }
</style>
